# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database — leave empty for SQLite; set for PostgreSQL on Render
DATABASE_URL=

# Caching — leave empty for local memory cache; set Redis URL in production
REDIS_URL=

# Optional providers (leave blank if unused)
OPENWEATHER_API_KEY=
NASA_FIRMS_MAP_KEY=
IMD_API_KEY=
BLITZORTUNG_USERNAME=
BLITZORTUNG_PASSWORD=

# Map — OpenFreeMap Liberty (vector style; no API key). Never use tile.openstreetmap.org.
MAP_TILE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAP_TILE_ATTRIBUTION=OpenFreeMap © OpenMapTiles Data from OpenStreetMap
MAP_TILE_MAX_ZOOM=18

# Vajra AI — platform assistant works without keys; optional LLM providers
AI_PROVIDER=platform
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Provider selection
DEFAULT_WEATHER_PROVIDER=open_meteo
WEATHER_CACHE_SECONDS=600
FORECAST_CACHE_SECONDS=1800
ALERT_CACHE_SECONDS=300
EARTHQUAKE_CACHE_SECONDS=600

# Logging
LOG_LEVEL=INFO
